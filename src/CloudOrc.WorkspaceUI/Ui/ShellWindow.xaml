<Window x:Class="CloudOrc.WorkspaceUI.Ui.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CloudOrc Remote Workspace"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="10" Height="96" UseLayoutRounding="True"
        AutomationProperties.Name="CloudOrc Remote Workspace panel">
  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition x:Name="ColA" Width="*"/>
      <ColumnDefinition x:Name="ColB" Width="Auto"/>
    </Grid.ColumnDefinitions>

    <!-- ============================ EDGE HANDLE (idle state) ============================ -->
    <Border x:Name="Handle" Grid.Column="1" Width="10" Height="96" CornerRadius="6,0,0,6"
            Background="{DynamicResource RailBg}" Opacity="0.85" Cursor="Hand"
            ToolTip="CloudOrc (Ctrl+Alt+Shift+C)" AutomationProperties.Name="Open CloudOrc panel">
      <Grid>
        <Rectangle Width="3" Height="36" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource RailFg}" Opacity="0.7"/>
        <Ellipse x:Name="HandleBadge" Width="7" Height="7" Fill="{DynamicResource Bad}" VerticalAlignment="Top" Margin="0,6,0,0"
                 Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
      </Grid>
    </Border>

    <!-- ============================ ICON RAIL ============================ -->
    <Border x:Name="Rail" Grid.Column="1" Width="64" Background="{DynamicResource RailBg}" CornerRadius="10,0,0,10" Visibility="Collapsed">
      <DockPanel LastChildFill="False" Margin="0,8">
        <Button x:Name="LogoButton" DockPanel.Dock="Top" Style="{StaticResource RailButton}" Click="OnLogoClick"
                ToolTip="{Binding BrandName}" AutomationProperties.Name="CloudOrc home">
          <Grid>
            <TextBlock Style="{StaticResource Icon}" Text="&#xE753;" FontSize="22" Foreground="#60A5FA"/>
            <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-2"
                     x:Name="ConnDot" Fill="{DynamicResource Ok}"/>
          </Grid>
        </Button>
        <Rectangle DockPanel.Dock="Top" Height="1" Fill="#334155" Margin="10,6"/>
        <StackPanel x:Name="RailItemsHost" DockPanel.Dock="Top"/>
        <!-- Hide the rail to the screen edge (like the TSPlus panel's arrow). Click the edge handle to bring it back. -->
        <Button x:Name="HideRailButton" DockPanel.Dock="Bottom" Style="{StaticResource RailButton}" Click="OnHideRailClick"
                ToolTip="Hide to the edge (click the edge to show again)" AutomationProperties.Name="Hide to edge">
          <TextBlock x:Name="HideRailGlyph" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="16"/>
        </Button>
      </DockPanel>
    </Border>

    <!-- ============================ EXPANDED PANEL ============================ -->
    <Border x:Name="Panel" Grid.Column="0" Width="380" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}"
            BorderThickness="1,1,0,1" CornerRadius="10,0,0,10" Visibility="Collapsed" Margin="0,0,-1,0">
      <Grid>
        <DockPanel>
          <!-- Header -->
          <Border DockPanel.Dock="Top" Padding="14,12,8,10" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="OnPinClick" Content="&#xE718;"
                        ToolTip="Pin panel" AutomationProperties.Name="Pin panel"/>
                <Button Style="{StaticResource IconButton}" Click="OnCollapseClick" Content="&#xE711;"
                        ToolTip="Hide (Esc)" AutomationProperties.Name="Hide panel"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Logo}" Height="26" MaxWidth="90" Margin="0,0,8,0" Stretch="Uniform"
                       Visibility="{Binding Logo, Converter={StaticResource NullToVis}}"/>
                <StackPanel>
                  <TextBlock Text="{Binding BrandName}" Style="{StaticResource Title}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <Ellipse x:Name="HeaderDot" Width="8" Height="8" Fill="{DynamicResource Ok}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Style="{StaticResource Small}" Text="{Binding ConnectionText}"/>
                    <TextBlock Style="{StaticResource Small}" Text="  ·  Remote Workspace"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </Border>

          <!-- Banner (degraded / seat not linked) -->
          <Border DockPanel.Dock="Top" Background="{DynamicResource WarnSoft}" Padding="14,8"
                  Visibility="{Binding HasBanner, Converter={StaticResource BoolToVis}}">
            <TextBlock Style="{StaticResource Small}" Foreground="#92400E" Text="{Binding Banner}"/>
          </Border>

          <!-- Toast -->
          <Border x:Name="ToastBar" DockPanel.Dock="Bottom" Background="#0F172A" Padding="12,8" Margin="10" CornerRadius="6" Visibility="Collapsed">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="12.5"/>
          </Border>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,14,10" Background="{DynamicResource SurfaceBg}">
            <Grid>
              <!-- =================== APPS (RW-02) =================== -->
              <StackPanel x:Name="TabApps">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="OnSwitcherClick"
                          ToolTip="Ctrl+Alt+Shift+A" Content="Switcher"/>
                  <TextBlock Style="{StaticResource Section}" Text="{Binding AppsHeader}"/>
                </DockPanel>
                <!-- Full desktop: only what is running (owner decision 25 Nov 2026). Seamless / RemoteApp
                     (.connect, RemoteApp .rdp, HTML5 RemoteApp): no desktop or Start menu, so this panel is the
                     launcher — published apps and folders with Open, replacing the TSPlus floating panel. -->
                <StackPanel Visibility="{Binding ShowLauncher, Converter={StaticResource BoolToVis}}">
                  <TextBlock Style="{StaticResource Small}" Text="No applications are assigned to you yet. Use Support if you need one."
                             Visibility="{Binding HasPublishedApps, Converter={StaticResource InverseBoolToVis}}"/>
                  <ItemsControl ItemsSource="{Binding PublishedApps}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}" Width="108" Margin="0,0,6,6" Padding="8">
                          <StackPanel>
                            <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,2,0,4"/>
                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <Button Margin="0,6,0,0" Padding="6,3" Style="{StaticResource SecondaryButton}" Click="OnLaunchClick" Tag="{Binding}"
                                    AutomationProperties.Name="{Binding Name, StringFormat=Open {0}}">
                              <TextBlock Text="{Binding StateText}" FontSize="11.5"/>
                            </Button>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Section}" Text="RUNNING NOW"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Small}" Text="No application windows are open."
                           Visibility="{Binding HasRunningApps, Converter={StaticResource InverseBoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding RunningApps}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Padding="8">
                        <StackPanel>
                          <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                              <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Focus / restore" Click="OnFocusGroupClick" Tag="{Binding}"
                                      AutomationProperties.Name="Focus"/>
                              <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Show windows" Click="OnExpandGroupClick" Tag="{Binding}"
                                      Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Show windows"/>
                            </StackPanel>
                            <Image Source="{Binding Icon}" Width="22" Height="22" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="NoWrap"/>
                                <Border Background="{DynamicResource Accent}" CornerRadius="8" Padding="6,0" Margin="6,0,0,0"
                                        Visibility="{Binding HasMany, Converter={StaticResource BoolToVis}}">
                                  <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="11"/>
                                </Border>
                              </StackPanel>
                              <TextBlock Style="{StaticResource Small}" Text="{Binding StateSummary}"/>
                            </StackPanel>
                          </DockPanel>
                          <ItemsControl ItemsSource="{Binding Windows}" Margin="30,6,0,0"
                                        Visibility="{Binding Expanded, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <DockPanel Margin="0,2">
                                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Focus / restore" Click="OnFocusWindowClick" Tag="{Binding}" AutomationProperties.Name="Focus"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" Click="OnMinimizeWindowClick" Tag="{Binding}" AutomationProperties.Name="Minimize"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close (the app may ask to save)" Click="OnCloseWindowClick" Tag="{Binding}" AutomationProperties.Name="Close"/>
                                  </StackPanel>
                                  <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                    <TextBlock Style="{StaticResource Small}" Text="{Binding State}"/>
                                  </StackPanel>
                                </DockPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="OnShowDesktopClick"
                        Content="Switch to desktop" ToolTip="Show the remote Windows desktop (this session)"
                        Visibility="{Binding ShowLauncher, Converter={StaticResource InverseBoolToVis}}"/>
                <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0" Text="{Binding AppsTip}"/>
              </StackPanel>

              <!-- =================== BACKUP (RW-07) =================== -->
              <StackPanel x:Name="TabBackup" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="BACKUP"/>
                <Border Style="{StaticResource Card}" Background="{Binding BackupTone, Converter={StaticResource ToneToSoftBrush}}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE83D;" FontSize="20" Foreground="{Binding BackupTone, Converter={StaticResource ToneToBrush}}" Margin="0,0,10,0"/>
                      <TextBlock Style="{StaticResource Title}" Text="{Binding BackupHeadline}" Foreground="{Binding BackupTone, Converter={StaticResource ToneToBrush}}"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" Text="{Binding BackupDetail}"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <Button Style="{StaticResource PrimaryButton}" Content="Run backup now" Click="OnRunBackupClick"
                          IsEnabled="{Binding CanRunBackup}" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}"/>
                  <Button Style="{StaticResource SecondaryButton}" Content="Refresh" Margin="8,0,0,0" Click="OnRefreshBackupClick"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}"
                           Text="Only your workspace administrator can start a backup or change backup settings."/>
                <TextBlock Style="{StaticResource Section}" Text="RECENT BACKUPS"/>
                <ItemsControl ItemsSource="{Binding BackupHistory}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,3">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" Text="{Binding Verification}"/>
                        <TextBlock FontSize="12.5" Text="{Binding At, StringFormat={}{0:dd MMM yyyy  HH:mm}}"/>
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Small}" Margin="0,10,0,0" Text="Restore and backup settings are in the CloudOrc portal."/>
              </StackPanel>

              <!-- =================== FILES / CLIPBOARD / PRINT (§32) =================== -->
              <StackPanel x:Name="TabFiles" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="FILE TRANSFER"/>
                <Border x:Name="FilesCard" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Title}" x:Name="FilesTitle"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" x:Name="FilesDetail"/>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Small}" x:Name="FilesExtensions"/>
                <TextBlock Style="{StaticResource Section}" Text="SEND A FILE TO MY PC"/>
                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap"
                           Text="Pick a file on this server. A one-time download link (valid 15 minutes) is emailed to you — open it on your own PC."/>
                <Button x:Name="SendFileButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Content="Choose file and send" Click="OnSendFileClick"/>
                <Border x:Name="SendFileDone" Style="{StaticResource Card}" Background="{DynamicResource OkSoft}" Margin="0,10,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="SendFileDoneText" Style="{StaticResource Body}" Foreground="{DynamicResource Ok}"/>
                </Border>
              </StackPanel>

              <StackPanel x:Name="TabClipboard" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="CLIPBOARD"/>
                <Border x:Name="ClipCard" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Title}" x:Name="ClipTitle"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" x:Name="ClipDetail"/>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Small}" Text="This is set by your administrator. It cannot be changed from the panel."/>
              </StackPanel>

              <StackPanel x:Name="TabPrint" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="PRINT"/>
                <Border x:Name="PrintCard" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Title}" x:Name="PrintTitle"/>
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0" x:Name="PrintDetail"/>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Small}" Text="If a printer is missing, raise a ticket from Support — we attach your session details automatically."/>
              </StackPanel>

              <!-- =================== AI ASSIST (§33) =================== -->
              <DockPanel x:Name="TabAi" Visibility="Collapsed" LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Section}" Text="AI ASSIST"/>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ask" Margin="6,0,0,0" Click="OnAskClick" IsDefault="False"/>
                  <TextBox x:Name="AiInput" KeyDown="OnAiKeyDown" AutomationProperties.Name="Ask the AI assistant"/>
                </DockPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Small}" Text="Ask how to do something, or what a message means. The assistant explains and guides; it does not change your server."/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="8,4" Click="OnSuggestionClick" Content="How do I export data from Tally to Excel?"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="8,4" Click="OnSuggestionClick" Content="Why can't I print?"/>
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,6,6" Padding="8,4" Click="OnSuggestionClick" Content="Why is file copy blocked?"/>
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding Chat}" Margin="0,8,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="Bubble" CornerRadius="8" Padding="10,7" Margin="0,3" Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                          <TextBlock Text="{Binding Text}" FontSize="12.5"/>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding FromUser}" Value="True">
                            <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource AccentSoft}"/>
                            <Setter TargetName="Bubble" Property="Margin" Value="40,3,0,3"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Style="{StaticResource Small}" Text="Thinking…" Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </DockPanel>

              <!-- =================== SUPPORT (§33) =================== -->
              <StackPanel x:Name="TabSupport" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="SUPPORT"/>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding SupportOrganization}"/>
                    <TextBlock Style="{StaticResource Small}" Text="{Binding SupportContact}" Visibility="{Binding SupportContact, Converter={StaticResource NullToVis}}"/>
                  </StackPanel>
                </Border>
                <TextBlock Style="{StaticResource Section}" Text="RAISE A TICKET"/>
                <TextBlock Style="{StaticResource Small}" Text="Topic"/>
                <ComboBox x:Name="TicketCategory" Margin="0,2,0,8" SelectionChanged="OnTicketCategoryChanged" AutomationProperties.Name="Ticket topic"/>
                <StackPanel x:Name="TicketSubcategoryRow" Visibility="Collapsed">
                  <TextBlock Style="{StaticResource Small}" Text="Details"/>
                  <ComboBox x:Name="TicketSubcategory" Margin="0,2,0,8" AutomationProperties.Name="Ticket topic details"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Small}" Text="Subject"/>
                <TextBox x:Name="TicketSubject" Margin="0,2,0,8" MaxLength="200" AutomationProperties.Name="Ticket subject"/>
                <TextBlock Style="{StaticResource Small}" Text="What happened?"/>
                <TextBox x:Name="TicketBody" Margin="0,2,0,8" Height="96" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         MaxLength="5000" AutomationProperties.Name="Ticket description"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Send to support" Click="OnSendTicketClick"/>
                  <ComboBox x:Name="TicketPriority" Width="110" HorizontalAlignment="Left" SelectedIndex="1" AutomationProperties.Name="Priority">
                    <ComboBoxItem Content="Low" Tag="low"/>
                    <ComboBoxItem Content="Normal" Tag="medium"/>
                    <ComboBoxItem Content="High" Tag="high"/>
                    <ComboBoxItem Content="Urgent" Tag="urgent"/>
                  </ComboBox>
                </DockPanel>
                <TextBlock Style="{StaticResource Small}" Margin="0,8,0,0"
                           Text="Your session details (server, app, panel status) are attached so you don't have to repeat them. No passwords are ever sent."/>
                <Border x:Name="TicketDone" Style="{StaticResource Card}" Background="{DynamicResource OkSoft}" Margin="0,10,0,0" Visibility="Collapsed">
                  <TextBlock x:Name="TicketDoneText" Style="{StaticResource Body}" Foreground="{DynamicResource Ok}"/>
                </Border>
              </StackPanel>

              <!-- =================== ALERTS =================== -->
              <StackPanel x:Name="TabAlerts" Visibility="Collapsed">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Content="Mark all read" Click="OnMarkReadClick"
                          Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
                  <TextBlock Style="{StaticResource Section}" Text="ALERTS"/>
                </DockPanel>
                <TextBlock Style="{StaticResource Small}" Text="You're all caught up." Visibility="{Binding HasAlerts, Converter={StaticResource InverseBoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding Alerts}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border x:Name="Card" Style="{StaticResource Card}" Padding="10">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Small}" Text="{Binding CreatedAt, StringFormat={}{0:dd MMM HH:mm}}"/>
                            <TextBlock x:Name="AlertTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5"/>
                          </DockPanel>
                          <TextBlock Style="{StaticResource Small}" Text="{Binding Message}" Margin="0,3,0,0"/>
                        </StackPanel>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCritical}" Value="True">
                          <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Bad}"/>
                          <Setter TargetName="AlertTitle" Property="Foreground" Value="{DynamicResource Bad}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Read}" Value="True">
                          <Setter TargetName="Card" Property="Opacity" Value="0.7"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- =================== MORE (RW-09) =================== -->
              <StackPanel x:Name="TabMore" Visibility="Collapsed">
                <TextBlock Style="{StaticResource Section}" Text="SESSION"/>
                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Small}" Text="User"/>
                    <TextBlock Grid.Column="1" FontSize="12.5" Text="{Binding UserName}"/>
                    <TextBlock Grid.Row="1" Style="{StaticResource Small}" Text="Server"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Text="{Binding ServerName}"/>
                    <TextBlock Grid.Row="2" Style="{StaticResource Small}" Text="Session"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12.5" Text="{Binding SessionId}"/>
                    <TextBlock Grid.Row="3" Style="{StaticResource Small}" Text="Mode"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12.5" Text="{Binding LaunchModeText}"/>
                    <TextBlock Grid.Row="4" Style="{StaticResource Small}" Text="CloudOrc agent"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12.5">
                      <Run Text="{Binding ConnectionText, Mode=OneWay}"/><Run Text=" · v"/><Run Text="{Binding AgentVersion, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Grid.Row="5" Style="{StaticResource Small}" Text="Panel"/>
                    <TextBlock Grid.Row="5" Grid.Column="1" FontSize="12.5" Text="{Binding PanelVersion, StringFormat=v{0}}"/>
                  </Grid>
                </Border>

                <TextBlock Style="{StaticResource Section}" Text="SECURITY"/>
                <Border x:Name="SecurityCard" Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock x:Name="SecurityTitle" Style="{StaticResource Body}" FontWeight="SemiBold" Text="Checking…"/>
                    <TextBlock x:Name="SecurityMfa" Style="{StaticResource Small}" Margin="0,4,0,0"/>
                    <TextBlock x:Name="SecurityIp" Style="{StaticResource Small}"/>
                    <TextBlock x:Name="SecuritySignedIn" Style="{StaticResource Small}"/>
                  </StackPanel>
                </Border>

                <StackPanel x:Name="UsersSection" Visibility="Collapsed">
                  <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Padding="8,3"
                            Content="Add user" Click="OnAddUserClick" ToolTip="Opens the CloudOrc portal (user creation)"/>
                    <TextBlock Style="{StaticResource Section}" Text="USERS &amp; ACCESS"/>
                  </DockPanel>
                  <TextBlock x:Name="UsersEmpty" Style="{StaticResource Small}" Text="Loading users…"/>
                  <ItemsControl x:Name="UsersList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="10">
                          <StackPanel>
                            <TextBlock FontWeight="SemiBold" FontSize="12.5" Text="{Binding DisplayName}"/>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding Username}"/>
                            <TextBlock Style="{StaticResource Small}" Text="{Binding Summary}"/>
                            <WrapPanel Margin="0,6,0,0">
                              <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4" FontSize="11.5" Content="Send reset link" Click="OnUserResetClick" Tag="{Binding}"/>
                              <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4" FontSize="11.5" Content="Sign out session" Click="OnUserSignOutClick" Tag="{Binding}"/>
                              <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,6,4" FontSize="11.5" Content="2FA on / off" Click="OnUserTwoFactorClick" Tag="{Binding}"/>
                              <Button Style="{StaticResource DangerButton}" Padding="8,3" Margin="0,0,6,4" FontSize="11.5" Content="Suspend / reinstate" Click="OnUserSuspendClick" Tag="{Binding}"/>
                            </WrapPanel>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <TextBlock Style="{StaticResource Section}" Text="DISPLAY &amp; EXPERIENCE"/>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Style="{StaticResource Body}" Text="Panel side" Width="110" VerticalAlignment="Center"/>
                      <RadioButton x:Name="SideRight" Content="Right" GroupName="side" Margin="0,0,14,0" Checked="OnSideChanged"/>
                      <RadioButton x:Name="SideLeft" Content="Left" GroupName="side" Checked="OnSideChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                      <TextBlock Style="{StaticResource Body}" Text="Auto-hide after" Width="110" VerticalAlignment="Center"/>
                      <ComboBox x:Name="AutoHideBox" Width="100" SelectionChanged="OnAutoHideChanged">
                        <ComboBoxItem Content="2 seconds" Tag="2"/>
                        <ComboBoxItem Content="4 seconds" Tag="4"/>
                        <ComboBoxItem Content="8 seconds" Tag="8"/>
                        <ComboBoxItem Content="15 seconds" Tag="15"/>
                      </ComboBox>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Section}" Text="KEYBOARD"/>
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Small}" Text="Ctrl+Alt+Shift+C — open / hide this panel"/>
                    <TextBlock Style="{StaticResource Small}" Text="Ctrl+Alt+Shift+A — app switcher"/>
                    <TextBlock Style="{StaticResource Small}" Text="Alt+Tab — switch apps (Windows, unchanged)"/>
                    <TextBlock Style="{StaticResource Small}" Text="Alt+Page Up / Down — switch apps in a windowed RDP client"/>
                    <TextBlock Style="{StaticResource Small}" Text="Ctrl+Alt+Home — RDP connection bar (switch to your own PC)"/>
                    <TextBlock Style="{StaticResource Small}" Text="Ctrl+Alt+Break — RDP full screen / window"/>
                  </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Section}" Text="SESSION ACTIONS"/>
                <WrapPanel>
                  <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Content="Disconnect" Click="OnDisconnectClick"
                          ToolTip="Leave your apps running and close the connection. Reconnect later to continue."/>
                  <Button Style="{StaticResource DangerButton}" Margin="0,0,8,8" Content="Sign out" Click="OnSignOutClick"
                          ToolTip="Closes all your apps on this server."/>
                  <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Content="Hide panel for this session" Click="OnHideForSessionClick"
                          Visibility="{Binding CanHideForSession, Converter={StaticResource BoolToVis}}"/>
                </WrapPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DockPanel>

        <!-- Confirm overlay (sign out) -->
        <Grid x:Name="OtpOverlay" Background="#990F172A" Visibility="Collapsed">
          <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="16" Margin="20" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock x:Name="OtpTitle" Style="{StaticResource Title}"/>
              <TextBlock Style="{StaticResource Body}" Margin="0,8,0,8" TextWrapping="Wrap"
                         Text="For your security we emailed a verification code to the workspace owner. Enter it to continue."/>
              <TextBox x:Name="OtpInput" MaxLength="8" AutomationProperties.Name="Verification code"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0" Click="OnOtpCancel"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Confirm" Click="OnOtpConfirm"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>

        <Grid x:Name="ConfirmOverlay" Background="#990F172A" Visibility="Collapsed">
          <Border Background="{DynamicResource PanelBg}" CornerRadius="10" Padding="16" Margin="20" VerticalAlignment="Center">
            <StackPanel>
              <TextBlock x:Name="ConfirmTitle" Style="{StaticResource Title}"/>
              <TextBlock x:Name="ConfirmText" Style="{StaticResource Body}" Margin="0,8,0,14"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Margin="0,0,8,0" Click="OnConfirmCancel" IsCancel="True"/>
                <Button x:Name="ConfirmOk" Style="{StaticResource DangerButton}" Content="Continue" Click="OnConfirmOk"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
